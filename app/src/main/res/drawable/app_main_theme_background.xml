<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >

    <item android:state_pressed="true" >
        <shape android:shape="rectangle"  >
            <corners android:radius="27dp" />
            <stroke android:width="1.5dp" android:color="#00F2FE" />
            <gradient android:angle="0" android:startColor="#00F2FE" android:endColor="#9153F8" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"  >
            <corners android:radius="27dp" />
            <stroke android:width="1.5dp" android:color="#7D48F5" />
            <solid android:color="#7D48F5"/>
        </shape>
    </item>
    <item >
        <shape android:shape="rectangle"  >
            <corners android:radius="27dp" />
            <stroke android:width="1.5dp" android:color="#00F2FE" />
            <gradient android:angle="0" android:startColor="#00F2FE" android:endColor="#7D48F5" />
        </shape>
    </item>

</selector>